# Copy this file to .env and fill in your values
# Get an API key from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Supabase (shared database for exams, folders, settings)
# Create a project at https://supabase.com → Settings → API
# URL must match your project ref, e.g. https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin login (set these in Vercel Environment Variables for production)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=your_secure_password_here

# Google Drive OAuth Admin Client details (Required for Personal Drive Quota fallback uploads)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

